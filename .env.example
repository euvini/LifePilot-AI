# HTTP & Ambiente
NODE_ENV=development
PORT=3333
# Lista separada por vírgulas de origens permitidas no CORS (obrigatório em produção)
# Exemplo: https://lifepilot.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Ative TRUST_PROXY=1 quando hospedado atrás de proxy reverso confiável (ex.: Render)
TRUST_PROXY=0

# PostgreSQL (local Docker Compose — ver docker-compose.yml)
# Em produção (Supabase + Render), utilize a string do Supavisor Pooler (IPv4):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://lifepilot:lifepilot@localhost:5433/lifepilot?schema=public
DIRECT_URL=postgresql://lifepilot:lifepilot@localhost:5433/lifepilot?schema=public

# Base de dados isolada para testes e2e/integração (o nome DEVE terminar em _test)
TEST_DATABASE_URL=postgresql://lifepilot:lifepilot@localhost:5433/lifepilot_test?schema=public

# NestJS Observe (obter via: npx @nestjs/observe link)
# Não faça commit de segredos reais. Copie este arquivo para .env e preencha localmente.
OBSERVE_APP_KEY=your_observe_app_key
OBSERVE_APP_SECRET=your_observe_app_secret

# LLM / AI Task Suggestions
# Provedores suportados: 'openai' ou 'ollama'
LLM_PROVIDER=openai

# Configurações OpenAI (obrigatórias quando LLM_PROVIDER=openai):
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000

# Configurações Ollama (Local ou Ollama Cloud):
# Local:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434
# LLM_TIMEOUT_MS=60000
#
# Ollama Cloud (recomendado para produção sem GPU local):
# LLM_PROVIDER=ollama
# LLM_MODEL=beam:cloud
# LLM_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_api_key
# LLM_TIMEOUT_MS=60000

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
