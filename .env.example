# HTTP
PORT=3000

# PostgreSQL (local Docker Compose — see docker-compose.yml)
# Replace host/user/password/database when moving to a managed service.
DATABASE_URL=postgresql://lifepilot:lifepilot@localhost:5433/lifepilot?schema=public

# Isolated database for e2e/integration tests (name MUST end with _test)
TEST_DATABASE_URL=postgresql://lifepilot:lifepilot@localhost:5433/lifepilot_test?schema=public

# NestJS Observe (obtain via: npx @nestjs/observe link)
# Do not commit real secrets. Copy this file to .env and fill in local values.
OBSERVE_APP_KEY=your_observe_app_key
OBSERVE_APP_SECRET=your_observe_app_secret

# LLM / AI Task Suggestions (Fase 3)
# The API boots normally without LLM_API_KEY; 503 is returned only when requesting AI suggestions.
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000
